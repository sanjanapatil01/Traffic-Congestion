{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Start Traffic System Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Run System Test Suite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_system.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Train ML Congestion Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml/train_model.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
