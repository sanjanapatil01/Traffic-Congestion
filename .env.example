# ====================================================================
# SMART TRAFFIC CONGESTION PREDICTION AND MANAGEMENT SYSTEM
# Environment Configuration
# ====================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
# If PostgreSQL is not available locally, the system automatically falls back to SQLite (smart_traffic.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_traffic

# AI / LLM Recommendation Service (Google Gemini API)
# Get a free key from Google AI Studio: https://aistudio.google.com/
# If left empty, the system automatically uses the intelligent Rule-Based Traffic Advisor fallback
AI_API_KEY=

# LLM Model Name
AI_MODEL=gemini-1.5-flash

# Flask Server Config
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
